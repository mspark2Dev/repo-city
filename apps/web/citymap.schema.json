      "required": [
        "id",
        "districtId",
        "path",
        "name",
        "lang",
        "position",
        "footprint",
        "height",
        "metrics",
        "grade"
      ],
      "title": "Building",
      "type": "object"
    },
    "District": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
