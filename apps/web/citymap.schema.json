        "name": {
          "type": "string"
        },
        "cc": {
          "type": "integer"
        },
        "line": {
          "type": "integer"
        },
        "grade": {
          "enum": [
            "clean",
            "watch",
            "hot",
            "critical"
          ],
          "type": "string"
        },
        "y": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "cc",
        "line",
        "grade",
        "y",
        "height"
      ],
      "title": "Floor",
      "type": "object"
    },
    "Footprint": {
