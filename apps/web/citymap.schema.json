      "title": "District",
      "type": "object"
    },
    "Floor": {
      "additionalProperties": false,
      "description": "One function, drawn as a slab of the building it lives in.\n\n`y` and `height` are computed server-side so the stack stays deterministic and testable\nalongside the rest of the layout.",
