      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "districtId": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "lang": {
          "enum": [
            "python",
            "typescript",
            "javascript",
            "java",
            "kotlin",
            "c",
            "cpp",
            "go",
            "rust",
            "csharp",
            "ruby",
            "php",
            "swift",
            "scala",
            "objectivec",
            "lua",
            "perl",
            "r",
            "erlang",
            "fortran",
            "solidity",
            "zig",
            "vue",
            "gdscript",
            "plsql",
            "smalltalk",
            "ttcn",
            "other"
          ],
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "footprint": {
          "$ref": "#/$defs/Footprint"
        },
        "height": {
          "type": "number"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "grade": {
          "enum": [
            "clean",
            "watch",
            "hot",
            "critical"
          ],
          "type": "string"
        },
        "floors": {
          "items": {
            "$ref": "#/$defs/Floor"
          },
          "type": "array"
        }
