# OpenAI-compatible LLM endpoint used by the refactoring agent.
# Analysis and visualization work without this; only agent features need it.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen3.6-27B
LLM_API_KEY=dummy

# Model context length, and the portion a prompt may actually fill.
LLM_MAX_CONTEXT=120000
LLM_CONTEXT_BUDGET=60000

# Backend bind address. Loopback by default; the analyzer reads local source files.
API_HOST=127.0.0.1
API_PORT=8787
